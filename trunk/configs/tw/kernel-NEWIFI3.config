# padavan-tw：Newifi D3 的核心設定差異（由 trunk/configure 套用）
#
# 2.4 GHz（MT7603）開啟 802.11k：手機可以向 AP 要「附近同名 AP 的頻道清單」，漫遊時不用掃全部頻道。
# 驅動有程式碼但上游沒有編進去；5 GHz（MT7612）原本就有。只開 11k，不開 11v。
CONFIG_MT7603E_DOT11K_RRM_SUPPORT=y

# 黑潮 DNS 的資料區（0x1800000～0x1f80000，7.5 MB）用 JFFS2：NOR Flash 適用、斷電安全、會平均寫入位置
CONFIG_JFFS2_FS=y

# 交換器（mtk_esw）用單一 GMAC 的 VLAN 設定：WAN 與 LAN 都經 P6→GMAC1，P6 帶 VLAN 標籤（VID 1＝LAN、VID 2＝WAN），
# 對應 board.mk 的 USE_SINGLE_MAC（eth2.1／eth2.2）。上游 esw_common.h 固定雙 GMAC（WAN→P5），
# D3 實機因此 LAN／WAN 全不通（交換器把 WAN 送往沒接的 P5，P6 又不帶標籤）
CONFIG_RAETH_ESW_SINGLE_GMAC=y
