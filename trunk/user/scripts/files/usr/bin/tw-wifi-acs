#!/bin/sh
# padavan-tw 每日自動重選 Wi-Fi 頻道
#
# 由 rc 的 watchdog 每天在 tw_acs_hour（預設 4 點）起的 3 小時內每 10 分鐘呼叫一次：
#   tw-wifi-acs 日期 2.4G介面 5G介面 是否DBDC
# 手動執行（不檢查是否閒置，立刻重選）：
#   tw-wifi-acs now
#
# 做法：只處理「頻道設為自動、單純 AP 模式、Wi-Fi 有開」的頻段；
# Wi-Fi 60 秒內流量低於 2 MB 才動作，否則等下一次。完成後寫入 tw_acs_day（暫存，不寫 Flash），當天不再執行。
#
# 2026-11-23 起改成「不斷線優先」，依 5G → 2.4G 的順序：
#   1. 先量測：被動掃描鄰居，跟目前的頻道比分數；沒有明顯更乾淨的頻道就什麼都不做（多數晚上停在這裡，不斷線）
#   2. 要換頻道：先請漫遊中控用 11v 把這個頻段上的裝置請到另一個頻段（tw-roamd 的 /tmp/tw-roamd.evacuate，
#      只對同名的主網路、支援 11v 的裝置有效；之後由「回 5G」請回來），再 iwpriv set Channel 直接換，不重新啟動 Wi-Fi。
#      這顆驅動換頻道沒有 CSA，留在這個頻段的裝置（不支援 11v、IoT 網路）會斷線幾秒後自己連回來
#   3. 換不過去（頻道沒變）才重新啟動那個頻段
# 以前（到 2026-11-22）每天直接重新啟動兩個頻段讓驅動重選，頻道沒變也會讓所有裝置斷線幾秒。
# DBDC 機型（MT7915）的掃描與換頻道指令還沒在實機驗證，維持舊做法（重新啟動）。
#
# 5 GHz 鄰頻檢查（ROADMAP I13）：驅動只看「同一個頻道」的鄰居，看不到緊鄰頻段溢出的干擾
# （例：鄰居在 144（132–144），我們用 80 MHz 的 149–161，兩段緊貼著）。
# 驅動選好之後再被動掃描一次，連同 DFS 頻段（只聽不發），用下面的分數檢查：
#   每個鄰居的強度分＝訊號 dBm＋100（-50 dBm 以上算 50，-90 dBm 算 10）
#   和我們的頻段（依頻寬 20／40／80 MHz）重疊：扣 2 倍強度分
#   緊貼在頻段旁邊（頻道號差 4～5）且強於 -70 dBm：扣 1 倍強度分（溢出的干擾比同頻弱，但會抬高雜訊）
# 只有驅動選的頻道「有強的緊鄰鄰居」、而且另一個頻段的分數少 10 分以上時，才改用那個頻段
# （同分選頻道號小的），其餘情況都照驅動的選擇。可選的頻道跟驅動一樣只有 36–48、149–165
# （40／80 MHz 不選 165），DFS 頻道永遠不會選；驅動量到干擾（False CCA 超過 100）的頻段也不選。
# 改頻道只在執行當下生效（iwpriv set Channel），不寫設定；下次重啟 Wi-Fi 由驅動重新選、隔天再檢查。
# 2.4 GHz 不做：驅動已經會把鄰居左右各 4 個頻道算進干擾（1／6／11 的重疊）。
# DBDC 機型（MT7915）的掃描與換頻道指令還沒在實機驗證，先不做。
# nvram tw_acs_adj=0：每日檢查不掃描、不換頻道（2026-11-23 起兩個頻段都是；以前是「只用驅動重選」）。出廠預設 1（2026-11-21 D3 實機驗證：掃描期間換頻道表 13 次都正常換回、
# 整夜 11 次掃描的判斷都沒有來回換、80 MHz 下 iwpriv set Channel 換頻道正常）。

TAG="Wi-Fi 頻道"
LOCK=${TW_LOCK:-/var/run/tw-wifi-acs.pid}
TMP=${TW_TMP:-/tmp}/tw-wifi-acs.$$
IDLE_SEC=60
IDLE_BYTES=2000000
SYS=${TW_SYS:-/sys/class/net}
ADJ_DBM=-70	# 緊鄰頻段的鄰居要強於這個才算
ADJ_MARGIN=10	# 分數至少要少這麼多才換，避免為了一點差距多斷線一次
MARGIN2=15	# 2.4G 換頻道的門檻（2.4G 鄰居多，分數起伏大，門檻高一點）
WIDE_REGION=13	# 掃描時暫用的 5G 頻道表：36–64、100–144、149–165（驅動 Region 13）

log() {
	logger -t "$TAG" "$*"
	[ -t 1 ] && echo "$*"
}

# 重新啟動 Wi-Fi：會順便重啟 ralinkiappd 等常駐程式，不讓它們接著這個腳本的輸出
# （手動經 ssh 或管線執行時，呼叫者會一直等不到結束）；指令不存在或失敗要留紀錄
restart_radio() {
	"$1" </dev/null >/dev/null 2>&1 || log "$1 執行失敗（$?），這次沒有重新啟動"
}

force=0
if [ "$1" = "now" ]; then
	force=1
	day=$(date +%Y%m%d)
	if [ -d $SYS/rax0 ]; then
		if2=rax0; if5=ra0; dbdc=1
	elif [ -d $SYS/rai0 ]; then
		if2=ra0; if5=rai0; dbdc=0
	else
		if2=ra0; if5=-; dbdc=0
	fi
else
	day=$1; if2=$2; if5=$3; dbdc=$4
	[ -n "$day" ] && [ -n "$if2" ] || { echo "用法：tw-wifi-acs now" >&2; exit 1; }
fi

if [ -f "$LOCK" ] && kill -0 "$(cat "$LOCK")" 2>/dev/null; then
	exit 0
fi
echo $$ > "$LOCK"
trap 'rm -f "$LOCK" "$TMP".*' EXIT INT TERM

# $1 = rt（2.4G）或 wl（5G）
band_auto() {
	[ "$(nvram get ${1}_channel)" = "0" ] || return 1
	[ "$(nvram get ${1}_mode_x)" = "0" ] || return 1	# 中繼、WDS 的頻道跟著上游，不處理
	[ "$(nvram get ${1}_radio_x)" = "1" ] || return 1
	return 0
}

if_up() {
	[ -n "$1" ] && [ "$1" != "-" ] && [ -d "$SYS/$1" ] || return 1
	ip link show "$1" 2>/dev/null | grep -q '[<,]UP[,>]'
}

guest_of() { echo "${1%0}1"; }

# 介面的收發位元組總數（用 awk 計算，避免 32 位元溢位）
bytes() {
	for i in "$@"; do
		cat "$SYS/$i/statistics/rx_bytes" "$SYS/$i/statistics/tx_bytes" 2>/dev/null
	done | awk '{ s += $1 } END { printf "%.0f\n", s }'
}

channel_of() {
	if_up "$1" || { echo "關閉"; return; }
	c=$(iwconfig "$1" 2>/dev/null | sed -n 's/.*Channel[=: ]*\([0-9][0-9]*\).*/\1/p' | head -n1)
	echo "${c:-?}"
}

# 5G 頻寬（MHz）：wl_HT_BW 0＝20、1＝40、2 以上＝80
bw5() {
	case "$(nvram get wl_HT_BW)" in
	0) echo 20 ;;
	1) echo 40 ;;
	*) echo 80 ;;
	esac
}

# 被動掃描 5G（只聽 Beacon，不發 Probe），結果寫到 $TMP.scan
# 自動選頻時驅動的頻道表只有 36–64、149–165，看不到 DFS 頻段的鄰居；
# 國家碼台灣時，掃描期間暫時換成含 100–144 的頻道表，掃完馬上換回 0（自動選頻用的表）
survey5() {
	wide=0
	if [ "$(nvram get wl_country_code)" = "TW" ] &&
	   iwpriv "$if5" set CountryRegionABand=$WIDE_REGION >/dev/null 2>&1; then
		wide=1
	fi
	ok=0
	if iwpriv "$if5" set SiteSurvey= >/dev/null 2>&1; then
		sleep 5
		# 驅動會等掃描結束才回傳；結果依訊號由強到弱排列，太長時只截掉弱的
		iwpriv "$if5" get_site_survey > "$TMP.scan" 2>/dev/null && ok=1
	fi
	if [ $wide = 1 ] && ! iwpriv "$if5" set CountryRegionABand=0 >/dev/null 2>&1; then
		log "5 GHz 掃描後頻道表沒有換回來，重新啟動 5 GHz 讓驅動重新載入設定"
		restart_radio radio5_restart
		sleep 20
		return 1
	fi
	[ $ok = 1 ] && grep -q ':..:..:..:..:' "$TMP.scan"
}

# 驅動這次自動選頻量到的 False CCA（核心訊息「Channel N : Dirty = …, False CCA = …」，取最後一次）
cca5() {
	dmesg 2>/dev/null | awk '{
		for (i = 1; i <= NF; i++)
			if ($i == "Channel" && $(i + 2) == ":" && $(i + 3) == "Dirty")
				for (j = i; j < NF - 1; j++)
					if ($j == "CCA" && $(j + 1) == "=") {
						v = $(j + 2); sub(/,.*/, "", v)
						if ($(i + 1) + 0 > 14) cca[$(i + 1) + 0] = v + 0
					}
	} END { for (c in cca) print c, cca[c] }' > "$TMP.cca"
}

# 評分：$1＝頻寬 MHz、$2＝驅動選的頻道；讀 $TMP.cca 與 $TMP.scan
# 輸出一行「動作<Tab>頻道<Tab>原因」，動作是 switch（換）、keep（維持）或 none（不用處理）；
# 以「表 」開頭的是各頻段分數（手動執行時顯示）
# 注意：BusyBox awk 會把「變數 空格 (」當成呼叫函式（Call to undefined function），
# 字串接括號時中間要夾 ""，例：s = s "" (x ? "a" : "b")
pick5() {
	awk -v bw="$1" -v cur="$2" -v adj="$ADJ_DBM" -v margin="$ADJ_MARGIN" -v ccaf="$TMP.cca" '
	# 頻道所在頻段的最低、最高頻道（20 MHz 頻道號）
	function blo(c, w,   base, i) {
		if (c == 165 || w == 20) return c
		base = (c >= 149) ? 149 : ((c >= 100) ? 100 : 36)
		i = int((c - base) / 4)
		if (w == 40) return base + int(i / 2) * 8
		return base + int(i / 4) * 16
	}
	function bhi(c, w) {
		if (c == 165 || w == 20) return c
		return blo(c, w) + ((w == 40) ? 4 : 12)
	}
	function lbl(c, w) {
		return (blo(c, w) == bhi(c, w)) ? c "" : blo(c, w) "–" bhi(c, w)
	}
	# 頻道加上它的頻段，例：149（149–161）；20 MHz 只寫頻道
	function chb(c, w) {
		return (blo(c, w) == bhi(c, w)) ? c "" : c "（" lbl(c, w) "）"
	}
	# 驅動的訊號百分比換回 dBm（cmm_info.c 的公式反推；100% 代表 -50 dBm 以上）
	function dbm(p) {
		if (p >= 100) return -50
		if (p >= 24) return int((p - 24) * 10 / 26) - 80
		return int(p * 10 / 26) - 90
	}
	function dtxt(k) {
		return (pct[k] >= 100) ? "-50 dBm 以上" : dbm(pct[k]) " dBm"
	}
	# 頻道 c 的頻段被所有鄰居扣的分數；同時記下重疊、緊鄰的數量與緊鄰的鄰居
	function score(c,   lo, hi, k, w, d, s) {
		lo = blo(c, bw); hi = bhi(c, bw)
		s = 0; nov = 0; nadj = 0; adjs = ""
		for (k = 1; k <= n; k++) {
			w = dbm(pct[k]) + 100
			if (w < 1) w = 1
			if (nlo[k] <= hi && nhi[k] >= lo) {
				s += 2 * w; nov++
				continue
			}
			d = (nhi[k] < lo) ? lo - nhi[k] : nlo[k] - hi
			if (d <= 5 && dbm(pct[k]) >= adj) {
				s += w; nadj++
				if (nadj <= 2)
					adjs = adjs "" ((adjs == "") ? "" : "、") ssid[k] " " ch[k] "（" dtxt(k) "）"
			}
		}
		return s
	}
	function hot(c,   x) {
		for (x = blo(c, bw); x <= bhi(c, bw); x += 4)
			if ((x in cca) && cca[x] > 100) return 1
		return 0
	}
	BEGIN {
		h = "[0-9A-Fa-f][0-9A-Fa-f]"
		mac = "^" h ":" h ":" h ":" h ":" h ":" h "$"
		n = 0; hdrno = 0
	}
	FILENAME == ccaf { cca[$1 + 0] = $2 + 0; next }
	/BSSID/ { hdrno = ($1 == "No"); next }
	{
		b = 0
		for (i = 2; i <= NF; i++) if ($i ~ mac) { b = i; break }
		if (!b || b + 4 > NF) next
		c = (hdrno ? $2 : $1) + 0
		p = $(b + 2) + 0
		if (c <= 14 || $(b + 2) !~ /^[0-9]+$/) next
		s = ""
		for (i = (hdrno ? 3 : 2); i < b; i++) s = s "" ((s == "") ? "" : " ") $i
		if (s == "") s = "（隱藏）"
		# 同一台 AP 的多個 SSID（主網、訪客…）BSSID 只差頭尾，只算最強的一個
		key = c "-" substr($b, 4, 11)
		if (key in seen) {
			k = seen[key]
			# 一樣強時，有名稱的取代隱藏的（紀錄才看得出是哪一台）
			if (p < pct[k] || (p == pct[k] && !(ssid[k] == "（隱藏）" && s != "（隱藏）"))) next
		} else {
			k = ++n; seen[key] = k
		}
		ch[k] = c; pct[k] = p; ssid[k] = s
		ext = $(b + 4)
		if (ext ~ /ABOVE/) { nlo[k] = c; nhi[k] = c + 4 }
		else if (ext ~ /BELOW/) { nlo[k] = c - 4; nhi[k] = c }
		else { nlo[k] = c; nhi[k] = c }
		# 11ac 以上又開了 40 MHz 的，當作用 80 MHz（大多數 AP 的預設）
		if (nlo[k] != nhi[k] && $(b + 3) ~ /ac|ax/ && c != 165) { nlo[k] = blo(c, 80); nhi[k] = bhi(c, 80) }
	}
	END {
		if (cur !~ /^[0-9]+$/ || cur + 0 <= 14) { print "none"; exit }
		cur += 0
		cands = "36 40 44 48 149 153 157 161" (bw == 20 ? " 165" : "")
		m = split(cands, cl, " ")
		scur = score(cur); acur = nadj; ocur = nov; why = adjs
		best = 0; sbest = 0
		for (i = 1; i <= m; i++) {
			c = cl[i] + 0
			# 同一個頻段只算一次，用頻段裡最小的頻道代表
			if (i > 1 && blo(c, bw) == blo(cl[i - 1] + 0, bw)) continue
			s = score(c)
			t = "表 " lbl(c, bw) "：分數 " s "（重疊 " nov "、緊鄰 " nadj "）"
			mine = (blo(c, bw) == blo(cur, bw))
			if (hot(c) && !mine) { print t "，驅動量到干擾，不選"; continue }
			print t "" ((mine) ? "，目前的" : "")
			# 分數最低的；同分時維持目前的，其次選頻道號小的
			if (!best || s < sbest || (s == sbest && mine)) { best = c; sbest = s }
		}
		if (acur > 2) why = why " 等 " acur " 個"
		head = "目前 " chb(cur, bw) " 分數 " scur "（重疊 " ocur "、緊鄰 " acur "）"
		if (!best || blo(best, bw) == blo(cur, bw) || scur - sbest < margin) {
			r = head
			if (best && blo(best, bw) != blo(cur, bw)) r = r "；最好的 " lbl(best, bw) " 分數 " sbest "，差距不到 " margin "，維持"
			else r = r "；目前的頻段就是最乾淨的，維持"
			print "keep	" cur "	" r
			exit
		}
		print "switch	" best "	" head "" ((acur) ? "，緊鄰 " why : "") "；改用 " chb(best, bw) "，分數 " sbest
	}' "$TMP.cca" "$TMP.scan"
}

# 被動掃描 2.4G，結果寫到 $TMP.scan
survey2() {
	iwpriv "$if2" set SiteSurvey= >/dev/null 2>&1 || return 1
	sleep 4
	iwpriv "$if2" get_site_survey > "$TMP.scan" 2>/dev/null || return 1
	grep -q ':..:..:..:..:' "$TMP.scan"
}

# 驅動最近一次 2.4G 自動選頻（開機或重新啟動時）量到的「Dirty」（驅動自己選頻道用的分數，含實際的空中忙碌）
dirty2() {
	dmesg 2>/dev/null | awk '{
		for (i = 1; i <= NF; i++)
			if ($i == "Channel" && $(i + 2) == ":" && $(i + 3) == "Dirty" && $(i + 1) + 0 >= 1 && $(i + 1) + 0 <= 14) {
				v = $(i + 5); sub(/,.*/, "", v); d[$(i + 1) + 0] = v + 0
			}
	} END { for (c in d) print c, d[c] }' > "$TMP.dirty2"
}

# 2.4G 評分（只在 20 MHz 時做）：$1＝目前頻道；候選 1／6／11 加上目前的頻道
# 每個鄰居的強度分＝dBm＋100；頻道距離 d（0～4）的重疊比例＝(5－d)/5，乘 2（同頻滿分）
pick2() {
	awk -v cur="$1" -v margin="$MARGIN2" -v dfile="$TMP.dirty2" '
	function dbm(p) {
		if (p >= 100) return -50
		if (p >= 24) return int((p - 24) * 10 / 26) - 80
		return int(p * 10 / 26) - 90
	}
	function score(c,   k, d, w, s) {
		s = 0; nn = 0
		for (k = 1; k <= n; k++) {
			d = (c < nlo[k]) ? nlo[k] - c : ((c > nhi[k]) ? c - nhi[k] : 0)
			if (d > 4) continue
			w = dbm(pct[k]) + 100
			if (w < 1) w = 1
			s += 2 * w * (5 - d) / 5; nn++
		}
		return int(s)
	}
	BEGIN { h = "[0-9A-Fa-f][0-9A-Fa-f]"; mac = "^" h ":" h ":" h ":" h ":" h ":" h "$"; n = 0; hdrno = 0 }
	FILENAME == dfile { dirty[$1 + 0] = $2 + 0; next }
	/BSSID/ { hdrno = ($1 == "No"); next }
	{
		b = 0
		for (i = 2; i <= NF; i++) if ($i ~ mac) { b = i; break }
		if (!b || b + 4 > NF) next
		c = (hdrno ? $2 : $1) + 0
		p = $(b + 2) + 0
		if (c < 1 || c > 14 || $(b + 2) !~ /^[0-9]+$/) next
		key = c "-" substr($b, 4, 11)
		if (key in seen) { k = seen[key]; if (p <= pct[k]) next } else { k = ++n; seen[key] = k }
		pct[k] = p
		ext = $(b + 4)
		if (ext ~ /ABOVE/) { nlo[k] = c; nhi[k] = c + 4 }
		else if (ext ~ /BELOW/) { nlo[k] = c - 4; nhi[k] = c }
		else { nlo[k] = c; nhi[k] = c }
	}
	END {
		if (cur !~ /^[0-9]+$/ || cur + 0 < 1 || cur + 0 > 14) { print "none"; exit }
		cur += 0
		scur = score(cur); ncur = nn
		best = 0; sbest = 0
		m = split("1 6 11", cl, " ")
		if (cur != 1 && cur != 6 && cur != 11) cl[++m] = cur
		for (i = 1; i <= m; i++) {
			c = cl[i] + 0; s = score(c)
			print "表 頻道 " c "：分數 " s "（" nn " 個鄰居）" ((c == cur) ? "，目前的" : "")
			if (!best || s < sbest || (s == sbest && c == cur)) { best = c; sbest = s }
		}
		head = "目前 " cur " 分數 " scur "（" ncur " 個鄰居）"
		if (best == cur || scur - sbest < margin) {
			print "keep	" cur "	" head "" ((best != cur) ? "；最好的 " best " 分數 " sbest "，差距不到 " margin "，維持" : "；目前的頻道就是最乾淨的，維持")
			exit
		}
		# 驅動實際量過空中忙碌（Dirty）時，目標頻道不比目前空才換：鄰居的訊號強弱不等於它們真的在傳資料
		if ((cur in dirty) && (best in dirty) && dirty[best] >= dirty[cur]) {
			print "keep	" cur "	" head "；鄰居訊號看起來 " best " 比較好（分數 " sbest "），但驅動量到的忙碌程度 " best " 是 " dirty[best] "、目前 " dirty[cur] "，維持"
			exit
		}
		print "switch	" best "	" head "；改用 " best "，分數 " sbest "" ((best in dirty) ? "（驅動量到的忙碌程度 " dirty[best] " 對目前 " dirty[cur] "）" : "")
	}' "$TMP.dirty2" "$TMP.scan"
}

# 重新啟動某個頻段前，請漫遊中控先把這個頻段上支援 11v 的裝置移到另一個頻段（最多等 70 秒）
# $1＝2 或 5；漫遊中控沒在跑就直接回來
evacuate() {
	pidof tw-roamd >/dev/null 2>&1 || return 0
	rm -f /tmp/tw-roamd.evacuated
	echo "$1" > /tmp/tw-roamd.evacuate
	i=0
	while [ ! -f /tmp/tw-roamd.evacuated ] && [ $i -lt 70 ]; do sleep 1; i=$((i + 1)); done
	if [ -f /tmp/tw-roamd.evacuated ]; then
		set -- $(cat /tmp/tw-roamd.evacuated)
		[ "$2" -gt 0 ] 2>/dev/null && { log "重新啟動前請 $2 台裝置先移到另一個頻段（不接受 $3 台、沒送到 $4 台）"; sleep 8; }
	fi
	rm -f /tmp/tw-roamd.evacuate /tmp/tw-roamd.evacuated
}

# 量測 → 換頻道（不重啟）→ 換不過去才重啟；$1＝2 或 5。輸出「頻道 → 頻道」
retune() {
	band=$1
	if [ "$band" = 5 ]; then ifn=$if5; lbl="5 GHz"; else ifn=$if2; lbl="2.4 GHz"; fi
	cur=$(channel_of "$ifn")
	case "$cur" in ''|*[!0-9]*) echo "$cur（讀不到頻道，不處理）"; return ;; esac
	# nvram tw_acs_adj=0：不掃描、不換頻道（兩個頻段都是）
	[ "$(nvram get tw_acs_adj)" = "0" ] && { echo "$cur（tw_acs_adj=0，不檢查）"; return; }
	if [ "$band" = 5 ]; then
		if ! survey5; then log "$lbl：掃描失敗，維持頻道 $cur"; echo "$cur（掃描失敗）"; return; fi
		cca5
		pick5 "$(bw5)" "$cur" > "$TMP.pick"
	else
		case "$(nvram get rt_HT_BW)" in ""|0) ;; *) echo "$cur（40 MHz，不自動換）"; return ;; esac
		if ! survey2; then log "$lbl：掃描失敗，維持頻道 $cur"; echo "$cur（掃描失敗）"; return; fi
		dirty2
		pick2 "$cur" > "$TMP.pick"
	fi
	[ -t 1 ] && sed -n 's/^表 /  /p' "$TMP.pick" >&2
	line=$(grep -v '^表 ' "$TMP.pick" | head -n 1)
	act=${line%%	*}; rest=${line#*	}; ch=${rest%%	*}; why=${rest#*	}
	if [ "$act" != switch ]; then
		[ -n "$why" ] && [ "$act" = keep ] && log "$lbl：$why"
		echo "$cur（維持）"
		return
	fi
	log "$lbl：$why"
	# 這顆驅動換頻道時沒有頻道切換公告（CSA）：裝置一定會斷線重連（2026-11-23 D3 實測：iwpriv set Channel
	# 後電腦、手機都斷線；開 IEEE80211H 也一樣，而且驅動在中斷裡停 AP，核心出現 WARNING，不能用）。
	# 所以換之前先請這個頻段支援 11v 的裝置移到另一個頻段，換完再由「回 5G」請回來
	evacuate "$band"
	iwpriv "$ifn" set Channel="$ch" >/dev/null 2>&1
	sleep 5
	now=$(channel_of "$ifn")
	if [ "$now" = "$ch" ]; then
		echo "$cur → $now（直接換）"
		return
	fi
	# 換不過去：重新啟動這個頻段（驅動重新選；裝置剛才已經請到另一個頻段）
	log "$lbl：直接換頻道沒有成功（還是 $now），重新啟動這個頻段"
	if [ "$band" = 5 ]; then restart_radio radio5_restart; else restart_radio radio2_restart; fi
	sleep 20
	echo "$cur → $(channel_of "$ifn")（重新啟動）"
}

# 驅動選好 5G 頻道後的鄰頻檢查（說明見檔頭）
adj5() {
	[ "$(nvram get tw_acs_adj)" = "0" ] && return
	[ "$dbdc" = "1" ] && return
	cur=$(channel_of "$if5")
	case "$cur" in ''|*[!0-9]*) return ;; esac
	if ! survey5; then
		log "5 GHz 鄰頻檢查：掃描失敗，維持驅動的選擇"
		return
	fi
	cca5
	pick5 "$(bw5)" "$cur" > "$TMP.pick"
	[ -t 1 ] && sed -n 's/^表 /  /p' "$TMP.pick"
	line=$(grep -v '^表 ' "$TMP.pick" | head -n 1)
	act=${line%%	*}
	rest=${line#*	}
	ch=${rest%%	*}
	why=${rest#*	}
	case "$act" in
	switch)
		log "5 GHz 避開緊鄰的強訊號：$why"
		iwpriv "$if5" set Channel="$ch" >/dev/null 2>&1
		sleep 5
		;;
	keep)
		[ -n "$why" ] && log "5 GHz 鄰頻檢查：$why"
		;;
	esac
}

todo2=0
todo5=0
band_auto rt && if_up "$if2" && todo2=1
[ "$if5" != "-" ] && band_auto wl && if_up "$if5" && todo5=1

if [ $todo2 = 0 ] && [ $todo5 = 0 ]; then
	[ $force = 1 ] && log "沒有設為「自動」的頻道（或 Wi-Fi 沒開／中繼模式），不需要重選"
	nvram set tw_acs_day="$day"
	exit 0
fi

# 要檢查閒置的介面：DBDC 機型重啟會影響兩個頻段，兩個都要檢查
ifs=""
if [ "$dbdc" = "1" ]; then
	for i in "$if2" "$if5"; do if_up "$i" && ifs="$ifs $i $(guest_of "$i")"; done
else
	[ $todo2 = 1 ] && ifs="$ifs $if2 $(guest_of "$if2")"
	[ $todo5 = 1 ] && ifs="$ifs $if5 $(guest_of "$if5")"
fi

if [ $force = 0 ]; then
	b1=$(bytes $ifs)
	sleep $IDLE_SEC
	b2=$(bytes $ifs)
	used=$(awk -v a="$b1" -v b="$b2" 'BEGIN { printf "%.0f", b - a }')
	if [ "$used" -ge "$IDLE_BYTES" ] 2>/dev/null; then
		log "Wi-Fi 使用中（$(awk -v u="$used" 'BEGIN { printf "%.1f", u / 1000000 }') MB／分鐘），10 分鐘後再試"
		exit 0
	fi
fi

if [ "$dbdc" = "1" ]; then
	old2=$(channel_of "$if2"); old5=$(channel_of "$if5")
	restart_radio radio5_restart	# DBDC：5G 重新載入設定時兩個頻段一起重啟
	sleep 20
	log "每日重選頻道（重新啟動）：2.4 GHz $old2 → $(channel_of "$if2")；5 GHz $old5 → $(channel_of "$if5")"
else
	# 順序：先 5G 再 2.4G（5G 要重啟時，裝置可以先移到 2.4G）
	msg=""
	[ $todo5 = 1 ] && msg="5 GHz $(retune 5)"
	[ $todo2 = 1 ] && msg="${msg:+$msg；}2.4 GHz $(retune 2)"
	log "每日檢查頻道：$msg"
fi

nvram set tw_acs_day="$day"
exit 0
